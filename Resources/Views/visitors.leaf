<!DOCTYPE html>
<html>
<head>
<title>Visitors Analytics</title>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  .stat-value { font-size: 1.6em; font-weight: bold; }
  .panel-heading h3 { margin: 0; }
</style>
</head>
<body class="container">

<h1 class="text-center">Visitors Analytics</h1>
<p class="text-center text-muted">Data as of #(todayStr) UTC</p>

<div class="row">
  <!-- Daily API Users -->
  <div class="col-sm-6">
    <div class="panel panel-primary">
      <div class="panel-heading"><h3>Today — API Users</h3></div>
      <div class="panel-body">
        <table class="table table-condensed table-bordered">
          <thead><tr><th>Category</th><th class="text-right">Unique IPs</th><th class="text-right">Requests</th></tr></thead>
          <tbody>
            <tr><td>Uploaders</td><td class="text-right stat-value">#(dailyUploaders)</td><td class="text-right">#(dailyUploaderRequests)</td></tr>
            <tr><td>Random readers</td><td class="text-right stat-value">#(dailyRandomReaders)</td><td class="text-right">#(dailyRandomReaderRequests)</td></tr>
            <tr><td>Planetary ruins readers</td><td class="text-right stat-value">#(dailySeedReaders)</td><td class="text-right">#(dailySeedReaderRequests)</td></tr>
            <tr class="active"><td><strong>Total API</strong></td><td class="text-right stat-value"><strong>#(dailyApiTotal)</strong></td><td class="text-right"><strong>#(dailyApiTotalRequests)</strong></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Daily Dashboard Users -->
  <div class="col-sm-6">
    <div class="panel panel-info">
      <div class="panel-heading"><h3>Today — Dashboard Users</h3></div>
      <div class="panel-body">
        <table class="table table-condensed table-bordered">
          <thead><tr><th>Category</th><th class="text-right">Unique IPs</th><th class="text-right">Requests</th></tr></thead>
          <tbody>
            <tr><td>Dashboard visitors</td><td class="text-right stat-value">#(dailyDashboard)</td><td class="text-right">#(dailyDashboardRequests)</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <!-- Monthly API Users -->
  <div class="col-sm-6">
    <div class="panel panel-success">
      <div class="panel-heading"><h3>Last 30 Days — API Users</h3></div>
      <div class="panel-body">
        <table class="table table-condensed table-bordered">
          <thead><tr><th>Category</th><th class="text-right">Unique IPs</th><th class="text-right">Requests</th></tr></thead>
          <tbody>
            <tr><td>Uploaders</td><td class="text-right stat-value">#(monthlyUploaders)</td><td class="text-right">#(monthlyUploaderRequests)</td></tr>
            <tr><td>Random readers</td><td class="text-right stat-value">#(monthlyRandomReaders)</td><td class="text-right">#(monthlyRandomReaderRequests)</td></tr>
            <tr><td>Planetary ruins readers</td><td class="text-right stat-value">#(monthlySeedReaders)</td><td class="text-right">#(monthlySeedReaderRequests)</td></tr>
            <tr class="active"><td><strong>Total API</strong></td><td class="text-right stat-value"><strong>#(monthlyApiTotal)</strong></td><td class="text-right"><strong>#(monthlyApiTotalRequests)</strong></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Monthly Dashboard Users -->
  <div class="col-sm-6">
    <div class="panel panel-warning">
      <div class="panel-heading"><h3>Last 30 Days — Dashboard Users</h3></div>
      <div class="panel-body">
        <table class="table table-condensed table-bordered">
          <thead><tr><th>Category</th><th class="text-right">Unique IPs</th><th class="text-right">Requests</th></tr></thead>
          <tbody>
            <tr><td>Dashboard visitors</td><td class="text-right stat-value">#(monthlyDashboard)</td><td class="text-right">#(monthlyDashboardRequests)</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Daily Users & Requests Graph -->
<div class="row">
  <div class="col-xs-12">
    <div class="panel panel-default">
      <div class="panel-heading"><h3>Daily Users &amp; Requests — Last 30 Days</h3></div>
      <div class="panel-body">
        <canvas id="dailyChart" height="80" data-chart="#(chartDataAttr)"
                aria-label="Daily users and requests chart for the last 30 days" role="img"></canvas>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var raw = document.getElementById('dailyChart').getAttribute('data-chart') || '';
  var rows = raw.split(',').filter(Boolean).map(function (s) {
    var p = s.split('|');
    return { date: p[0], users: parseInt(p[1]) || 0, requests: parseInt(p[2]) || 0 };
  });
  var labels   = rows.map(function (r) { return r.date; });
  var users    = rows.map(function (r) { return r.users; });
  var requests = rows.map(function (r) { return r.requests; });

  var ctx = document.getElementById('dailyChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        {
          label: 'Unique Users',
          data: users,
          borderColor: 'rgb(54, 162, 235)',
          backgroundColor: 'rgba(54, 162, 235, 0.1)',
          tension: 0.2,
          yAxisID: 'yUsers'
        },
        {
          label: 'Total Requests',
          data: requests,
          borderColor: 'rgb(255, 99, 132)',
          backgroundColor: 'rgba(255, 99, 132, 0.1)',
          tension: 0.2,
          yAxisID: 'yRequests'
        }
      ]
    },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      scales: {
        yUsers: {
          type: 'linear',
          position: 'left',
          title: { display: true, text: 'Unique Users' },
          beginAtZero: true
        },
        yRequests: {
          type: 'linear',
          position: 'right',
          title: { display: true, text: 'Total Requests' },
          beginAtZero: true,
          grid: { drawOnChartArea: false }
        }
      }
    }
  });
})();
</script>

<!-- Top 10 IPs by Requests Today -->
#if(count(topIPGroups) > 0):
<h2>Top 10 IPs by Requests Today</h2>
<p class="text-muted">
  <span class="label label-warning">Yellow</span> = &gt;2× group average (≥5 requests) &nbsp;
  <span class="label label-danger">Red</span> = &gt;3× group average (≥5 requests)
</p>
<div class="row">
  #for(group in topIPGroups):
  <div class="col-sm-6">
    <div class="panel panel-default">
      <div class="panel-heading"><h3>#(group.categoryLabel)</h3></div>
      <div class="panel-body">
        <table class="table table-condensed table-bordered">
          <thead><tr><th>IP Address</th><th class="text-right">Requests Today</th></tr></thead>
          <tbody>
            #for(entry in group.entries):
            <tr class="#(entry.rowClass)">
              <td><code>#(entry.ip)</code></td>
              <td class="text-right">#(entry.requestCount)</td>
            </tr>
            #endfor
          </tbody>
        </table>
      </div>
    </div>
  </div>
  #endfor
</div>
#endif

<!-- Ten Recent Uploads -->
<div class="row">
  <div class="col-xs-12">
    <div class="panel panel-default">
      <div class="panel-heading"><h3>Ten Recent Uploads</h3></div>
      <div class="panel-body">
        <table class="table table-striped table-condensed table-bordered">
          <thead>
            <tr>
              <th>#</th>
              <th>Seed</th>
              <th>Map size</th>
              <th>Blueprint (cells)</th>
              <th>File size</th>
              <th>Game version</th>
              <th>Uploaded (UTC)</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            #if(count(recentUploads) > 0):
            #for(upload in recentUploads):
            <tr>
              <td>#(upload.id)</td>
              <td>#(upload.seed)</td>
              <td>#(upload.mapSize)×#(upload.mapSize)</td>
              <td>#(upload.width)×#(upload.height)</td>
              <td class="text-muted">N/A</td>
              <td>#(upload.version)</td>
              <td>#(upload.updatedAt)</td>
              <td><a href="/view/map/#(upload.id)">View</a></td>
            </tr>
            #endfor
            #else:
            <tr><td colspan="8" class="text-center text-muted">No uploads yet</td></tr>
            #endif
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

</body>
</html>
